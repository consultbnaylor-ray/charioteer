# Client. Public by design. These are the live Charioteer project.
# Expo reads EXPO_PUBLIC_* from .env. If they are unset, the app still uses these
# same values (see src/config/publicEnv.ts).
EXPO_PUBLIC_SUPABASE_URL=https://jvmmuhljklkahebxdsah.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CjeTAzHc4MrdXb2wDBkMwg_6aYBC34S
# Legacy anon key. The app uses it only when the publishable key above is empty.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp2bW11aGxqa2xrYWhlYnhkc2FoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE2MzI4MTcsImV4cCI6MjEwNzIwODgxN30.jyrAWcidsDfTWTegQWUjGcf-FjqS0aq2CcwzYRNhlYo

# Demo mode is off unless this is exactly demo. Then the app ignores Supabase.
# EXPO_PUBLIC_DATA_MODE=demo

# Server only. Set on Supabase with:
#   supabase secrets set XAI_API_KEY=your-key
# Never prefix this with EXPO_PUBLIC_. The app must not see it.
XAI_API_KEY=

# Optional override for the edge function. The default is grok-4.3 with
# reasoning_effort low (the documented fast setting that still reasons a little).
# none produced one-line replies. grok-4.7 defaults to high and cannot turn
# reasoning off; if you set that model, the function uses low.
THUMOS_MODEL=grok-4.3
