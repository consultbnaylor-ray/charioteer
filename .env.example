# Client. The anon key is public by design. Copy the local values from `supabase status`.
# Leave these blank to run the on-device sample (no Supabase required).
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# demo | supabase. Defaults to demo when the URL or anon key is empty.
EXPO_PUBLIC_DATA_MODE=demo

# Server only. Set on Supabase with:
#   supabase secrets set XAI_API_KEY=your-key
# Never prefix this with EXPO_PUBLIC_. The app must not see it.
XAI_API_KEY=

# Optional. The verified default is grok-4.7 via chat completions.
THUMOS_MODEL=grok-4.7
