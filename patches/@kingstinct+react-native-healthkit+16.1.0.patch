--- /dev/null
+++ b/node_modules/@kingstinct/react-native-healthkit/ios/AuthorizationCatcher.m
@@ -0,0 +1,42 @@
+#import "AuthorizationCatcher.h"
+
+static NSError *CharioteerExceptionError(NSException *exception) {
+  NSString *reason = exception.reason;
+  if (reason.length == 0) reason = exception.name;
+  if (reason.length == 0) reason = @"HealthKit authorization failed";
+  return [NSError errorWithDomain:@"CharioteerHealthKit"
+                             code:1
+                         userInfo:@{ NSLocalizedDescriptionKey: reason }];
+}
+
+NSError * _Nullable CharioteerRequestAuthorizationCatchingExceptions(
+  HKHealthStore * _Nonnull store,
+  NSSet * _Nonnull share,
+  NSSet * _Nonnull read,
+  void (^ _Nonnull completion)(BOOL success, NSError * _Nullable error)
+) {
+  @try {
+    [store requestAuthorizationToShareTypes:share readTypes:read completion:^(BOOL success, NSError *error) {
+      completion(success, error);
+    }];
+    return nil;
+  } @catch (NSException *exception) {
+    return CharioteerExceptionError(exception);
+  }
+}
+
+NSError * _Nullable CharioteerGetRequestStatusCatchingExceptions(
+  HKHealthStore * _Nonnull store,
+  NSSet * _Nonnull share,
+  NSSet * _Nonnull read,
+  void (^ _Nonnull completion)(NSInteger status, NSError * _Nullable error)
+) {
+  @try {
+    [store getRequestStatusForAuthorizationToShareTypes:share readTypes:read completion:^(HKAuthorizationRequestStatus status, NSError *error) {
+      completion((NSInteger)status, error);
+    }];
+    return nil;
+  } @catch (NSException *exception) {
+    return CharioteerExceptionError(exception);
+  }
+}
