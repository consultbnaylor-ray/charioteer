+#import <Foundation/Foundation.h>
+#import <HealthKit/HealthKit.h>
+
+/// HealthKit can raise an Objective-C exception from these calls.
+/// A class method is required: under SWIFT_OBJC_INTEROP_MODE=objcxx a plain C
+/// function imports its block as non-escaping, and HealthKit calls it later.
+@interface CharioteerAuthCatcher : NSObject
+
++ (NSError * _Nullable)requestAuthorizationWithStore:(HKHealthStore * _Nonnull)store
+                                               share:(NSSet<HKSampleType *> * _Nonnull)share
+                                                read:(NSSet<HKObjectType *> * _Nonnull)read
+                                          completion:(void (^ _Nonnull)(BOOL success, NSError * _Nullable error))completion
+    NS_SWIFT_NAME(requestAuthorization(store:share:read:completion:));
+
++ (NSError * _Nullable)requestStatusWithStore:(HKHealthStore * _Nonnull)store
+                                        share:(NSSet<HKSampleType *> * _Nonnull)share
+                                         read:(NSSet<HKObjectType *> * _Nonnull)read
+                                   completion:(void (^ _Nonnull)(NSInteger status, NSError * _Nullable error))completion
+    NS_SWIFT_NAME(requestStatus(store:share:read:completion:));
+
+@end
