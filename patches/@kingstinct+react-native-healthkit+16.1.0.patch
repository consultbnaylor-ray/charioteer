--- /dev/null
+++ b/node_modules/@kingstinct/react-native-healthkit/ios/AuthorizationCatcher.m
@@ -0,0 +1,53 @@
+#import "AuthorizationCatcher.h"
+
+static NSError *CharioteerExceptionError(NSException *exception) {
+  NSString *reason = exception.reason;
+  if (reason.length == 0) reason = exception.name;
+  if (reason.length == 0) reason = @"HealthKit authorization failed";
+  return [NSError errorWithDomain:@"CharioteerHealthKit"
+                             code:1
+                         userInfo:@{ NSLocalizedDescriptionKey: reason }];
+}
+
+/// A workout route can be read. It is not a share type, and passing it there raises.
+static NSSet *CharioteerShareWithoutRoute(NSSet *share) {
+  HKSeriesType *route = [HKSeriesType workoutRouteType];
+  if (route == nil || ![share containsObject:route]) return share;
+  NSMutableSet *copy = [NSMutableSet setWithSet:share];
+  [copy removeObject:route];
+  return copy;
+}
+
+@implementation CharioteerAuthCatcher
+
++ (NSError * _Nullable)requestAuthorizationWithStore:(HKHealthStore *)store
+                                               share:(NSSet<HKSampleType *> *)share
+                                                read:(NSSet<HKObjectType *> *)read
+                                          completion:(void (^)(BOOL, NSError * _Nullable))completion {
+  NSSet *shareable = CharioteerShareWithoutRoute(share);
+  @try {
+    [store requestAuthorizationToShareTypes:shareable readTypes:read completion:^(BOOL success, NSError *error) {
+      completion(success, error);
+    }];
+    return nil;
+  } @catch (NSException *exception) {
+    return CharioteerExceptionError(exception);
+  }
+}
+
++ (NSError * _Nullable)requestStatusWithStore:(HKHealthStore *)store
+                                        share:(NSSet<HKSampleType *> *)share
+                                         read:(NSSet<HKObjectType *> *)read
+                                   completion:(void (^)(NSInteger, NSError * _Nullable))completion {
+  NSSet *shareable = CharioteerShareWithoutRoute(share);
+  @try {
+    [store getRequestStatusForAuthorizationToShareTypes:shareable readTypes:read completion:^(HKAuthorizationRequestStatus status, NSError *error) {
+      completion((NSInteger)status, error);
+    }];
+    return nil;
+  } @catch (NSException *exception) {
+    return CharioteerExceptionError(exception);
+  }
+}
+
+@end
