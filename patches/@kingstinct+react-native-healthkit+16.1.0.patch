+func cappedRouteLocations(_ locations: [CLLocation], limit: Int = 500) -> [CLLocation] {
+  guard locations.count > limit, limit >= 2 else { return locations }
+  let last = locations.count - 1
+  var sampled: [CLLocation] = []
+  sampled.reserveCapacity(limit)
+  var previous = -1
+  for step in 0..<limit {
+    let index = Int((Double(step) * Double(last) / Double(limit - 1)).rounded())
+    if index != previous {
+      sampled.append(locations[index])
+      previous = index
+    }
+  }
+  return sampled
+}
