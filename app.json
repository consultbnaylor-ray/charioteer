{
  "expo": {
    "name": "Charioteer",
    "slug": "charioteer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ios/icon-1024.png",
    "scheme": "charioteer",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "uk.co.quanticalabs.charioteer",
      "buildNumber": "6",
      "appleTeamId": "5FMDXKAX7V",
      "usesAppleSignIn": true,
      "icon": "./assets/brand/ios/icon-1024.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Charioteer uses the microphone so you can speak with Thumos. Audio is sent to the coach only while a voice conversation is open."
      }
    },
    "android": {
      "package": "uk.co.quanticalabs.charioteer",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0C",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon-32.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0C0C",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Charioteer uses the microphone so you can speak with Thumos. Audio is sent to the coach only while a voice conversation is open.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Charioteer reads steps, sleep, resting heart rate, heart rate variability, workouts, and weight so you and Thumos can see how your body is doing. Other people cannot see this.",
          "NSHealthUpdateUsageDescription": "Charioteer does not write to Apple Health. This message is required because the app includes the HealthKit capability."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
